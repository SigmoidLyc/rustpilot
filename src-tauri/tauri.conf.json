{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustPilot",
  "version": "0.1.0",
  "identifier": "com.rustpilot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RustPilot",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "dataDirectory": "RustPilot-Dev",
        "create": true,
        "visible": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/WebView2Loader.dll": "WebView2Loader.dll",
      "resources/WebView2Loader.LICENSE.txt": "WebView2Loader.LICENSE.txt",
      "resources/rustpilot.exe.manifest": "rustpilot.exe.manifest"
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
