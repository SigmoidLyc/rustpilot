# Set one of these before launching Tauri to start in OpenAI-compatible mode.
RUSTPILOT_API_KEY=

# These values are optional. The in-app settings panel is the source of truth
# for the endpoint and model; the API key remains in memory only.
RUSTPILOT_API_BASE_URL=https://api.openai.com/v1
RUSTPILOT_MODEL=gpt-4o-mini

# Optional local A2A JSON-RPC endpoint.
# RUSTPILOT_A2A_ADDR=127.0.0.1:10000
